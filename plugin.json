{
  "id": "com.github.pxasen.playlist-bridge",
  "name": "歌单文件桥接",
  "version": "1.0.2",
  "description": "直接读取任意播放器保存的 m3u8 / m3u / pls / xspf / wpl / asx / fpl / fplite 歌单文件，在 Twilight Echo 里按原样浏览和播放，无需逐个重新整理。",
  "author": "Px-asen",
  "license": "MIT",
  "type": ["provider", "ui"],
  "main": "index.mjs",
  "engines": {
    "twilightEcho": ">=1.3.0"
  },
  "apiVersion": 3,
  "permissions": ["network", "filesystem:read", "settings", "library:read", "ui:inject"],
  "repository": "https://github.com/Px-asen/twilight-playlist-bridge"
}
